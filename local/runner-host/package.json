{
  "name": "@software-factory/runner-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The generic runner host daemon: connects outbound to the factory over the signed channel, claims jobs, pushes run branches with the job token, and drives a runner adapter (runner-orca). Runs on a person's machine.",
  "bin": {
    "sf-runner": "./bin/sf-runner"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "runner": "node --experimental-transform-types --no-warnings src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@software-factory/harness-claude": "workspace:*",
    "@software-factory/runner-contract": "workspace:*",
    "@software-factory/runner-orca": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@software-factory/config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
