{
  "name": "@software-factory/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The cloud engine Worker: one Workflow per work item, the signed runner channel, outbox delivery, cron, and the operations RPC for sf-app.",
  "scripts": {
    "dev": "wrangler d1 migrations apply software-factory --local && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@software-factory/connector-github": "workspace:*",
    "@software-factory/connector-webhook": "workspace:*",
    "@software-factory/core": "workspace:*",
    "@software-factory/db": "workspace:*",
    "@software-factory/runner-contract": "workspace:*",
    "kysely": "0.29.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@software-factory/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
