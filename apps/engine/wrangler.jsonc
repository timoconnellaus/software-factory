// sf-engine: the cloud engine Worker. The runner channel (/runner/v1/*), the client door for the
// desktop app and the CLI, the GitHub App's installation webhook, the new core's MCP server, plugin
// triggers and runs (spec 70), the minute cron, and the operations RPC (EngineApi) that sf-app
// calls through a service binding.
// Account-agnostic: no account or resource IDs are committed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sf-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Next to D1 (ADR 0241), for the fetch handlers: the runner channel, the door and the GitHub
  // webhook. RPC from sf-app runs where sf-app runs.
  "placement": { "region": "aws:us-west-1" },
  // Workers Logs (AGENTS.md, Cloudflare cost, rule 11). Every request is logged (1.0, no
  // sampling): the owner chose this on 12 Nov 2026, so a one-off failure is never lost to sampling.
  // From 1 Dec 2026 logs are billed by size (Observability pricing): 50 GB ingested per billing
  // cycle included, then $0.25/GB, measured uncompressed, and the 50 GB is shared with traces and
  // every other Cloudflare log. This Worker's invocations are mostly machine chatter: per runner a
  // heartbeat and a claim every 20 s, per running job an event batch up to every 3 s, plus the
  // desktop app's door calls. Estimated before the cutover (with more chatter per job than now)
  // at 11 to 44 GB a month against the 50 GB included. Volume is kept down at the source: the hot
  // paths (heartbeat, claim, polls) write no per-request lines, only warnings and errors. If usage
  // nears 50 GB, cut log lines first; sampling is the owner's call.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // CPU per invocation (rule 11), default 30 s. The cap applies to every invocation of this Worker:
  // channel, door and webhook requests, sf-app's RPCs, the cron and every request to its Durable
  // Object. CPU time excludes waiting on D1, GitHub, a plugin's Dynamic Worker or a socket. The
  // heaviest legitimate work is a few hundred ms at most, by estimate (not measured): a phone's
  // attestation chain (DER parsing of 3 to 5 certificates and their signature checks in Web
  // Crypto), a flow run's prompt or a batch of its events (zod and JSON over at most a few MB), and
  // a cron tick (bounded queries; its own platform limit is 30 s). 10 s is many times that, and
  // stops a runaway loop billing 30 s each time. Raise it if a call is ever cut off.
  "limits": { "cpu_ms": 10000 },
  // Runner hosts reach the channel here (outbound HTTPS from the runner, ADR 0016). Nothing else on
  // this host is public: the operations API is RPC over a service binding (ADR 0051).
  // The GitHub App's webhook is a Workers route on sf-app's hostname: routes run in front
  // of a Custom Domain, so /webhooks/* reaches this Worker without sf-app forwarding it.
  "routes": [
    { "pattern": "sf-engine.zerobsai.com", "custom_domain": true },
    { "pattern": "software-factory.zerobsai.com/webhooks/*", "zone_name": "zerobsai.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // The factory's one database. Bound by name; created by scripts/deploy/provision.ts. Migrations
  // live in packages/db and are applied from here (the first Worker in deploy order that sets them).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "software-factory",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      // One ClientHub per person (spec 40 M2b): their desktop apps' live connections.
      { "name": "CLIENT_HUB", "class_name": "ClientHub" }
    ]
  },
  "migrations": [
    { "tag": "v1-planning-hub", "new_sqlite_classes": ["PlanningHub"] },
    { "tag": "v2-client-hub", "new_sqlite_classes": ["ClientHub"] },
    { "tag": "v3-terminal-relay", "new_sqlite_classes": ["TerminalRelay"] },
    // Spec 44 PR 3: nothing waits on the PlanningHub any more (held calls poll in the Worker, and
    // Planning views hear changes on the ClientHub), so the class and its objects are deleted. It
    // kept no storage.
    { "tag": "v4-delete-planning-hub", "deleted_classes": ["PlanningHub"] },
    // Cutover (spec 70 milestone 5): the web terminal and the job line served only the old core's
    // stages (a flow job has no terminal), so the class and its objects are deleted. Its sockets
    // and tickets were in memory; it kept no storage that anything reads.
    { "tag": "v5-delete-terminal-relay", "deleted_classes": ["TerminalRelay"] }
  ],
  // The phone's unsigned mobile/nonce (ADR 0541): ten a minute per caller (the keyed hash of its
  // address, mobileCaller), counted at Cloudflare's edge location, so an over-limit caller is
  // refused before the call reaches D1. The namespace id is ours to pick, not an account's: a
  // unique positive integer keeps these counters apart from any other binding on the account.
  "ratelimits": [
    {
      "name": "MOBILE_NONCE_LIMIT",
      "namespace_id": "3110",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Plugins (spec 70 milestone 2, ADR 0660): each plugin's code runs as a Dynamic Worker loaded
  // through this binding (packages/plugins), with no network of its own (`globalOutbound: null`).
  // Workers Paid plan only. Billed per unique worker a day: one per plugin version in use.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Every minute: outbox retries, the new core's lapsed runs, schedules and run-event prune, and
  // the channel store's prune; hourly, expired device codes and connect states.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://software-factory.zerobsai.com",
    "GH_APP_ID": "5705909",
    // Its install page is github.com/apps/<slug> (github.connectStart).
    "GH_APP_SLUG": "software-factory-zerobsai",
    // The default-branch commit this engine was deployed from (ADR 0360): the deploy sets it with
    // `--var DEPLOYED_SHA:<sha>`. Empty: a dev engine (no updates).
    "DEPLOYED_SHA": "",
    // The last commit at or before DEPLOYED_SHA that changed runner code (ADR 0520): the deploy
    // computes it with git and sets `--var RUNNER_SHA:<sha>`, and runners are asked to run it, so a
    // deploy that changed no runner code moves no runner. Empty: runners get DEPLOYED_SHA.
    "RUNNER_SHA": "",
    // Accept presence proofs from desktop devices with a software key (ADR 0391): "1" only on a local
    // dev engine. Anything else refuses them, so a gate decision needs a Secure Enclave key.
    // Macs only: a phone with a software key never gives a proof, whatever this says (ADR 0541).
    "DESKTOP_ALLOW_SOFTWARE_KEYS": "",
    // The oldest desktop door protocol the client door serves (ADR 0393). Older builds get 426
    // `update_required` and update themselves. Empty or 0 = serve every build. Raise it only when
    // older builds must stop; the app's own number is DOOR_PROTOCOL in apps/desktop. CI and the
    // deploy refuse a floor above what the newest published build speaks (scripts/deploy/desktop-floor.ts).
    "DESKTOP_MIN_PROTOCOL": "2",
    // The phone app's signing certificates (ADR 0541): SHA-256, comma-separated, as `keytool -list
    // -v` prints them. A phone registers only if Android attests our package signed with one of
    // these. The release key's goes here once the owner makes it (spec 60, "What the owner must
    // do"); a dev engine may add the debug key's. Empty: every phone sign-in is refused.
    "MOBILE_SIGNING_CERTS": "",
    // The oldest Android security patch a phone may sign in with, in months (ADR 0541). Empty: 18.
    "MOBILE_MAX_PATCH_AGE_MONTHS": "",
    // "1" swaps the GitHub App for an in-D1 fake (tests and local dev only).
    "GITHUB_FAKE": ""
  }
  // Secrets (set by the deploy workflow with `wrangler secret bulk`, never committed):
  // RUNNER_CHANNEL_SECRET, GH_APP_PRIVATE_KEY, GH_APP_WEBHOOK_SECRET and FLOW_GATEWAY_KEY (the new core's
  // gateway secrets, spec 70 milestone 2). They are typed in src/secrets.ts rather than with
  // `secrets.required`, which would make `wrangler deploy` fail until they exist. Without them the
  // runner channel answers 503, GitHub calls are refused as `unavailable` and the webhook answers
  // 503.
}
