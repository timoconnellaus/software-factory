// sf-engine: the cloud engine Worker. One Cloudflare Workflow per work item, the runner channel
// (/runner/v1/*), outbox delivery and the minute cron, and the operations RPC (EngineApi) that
// sf-app calls through a service binding.
// Account-agnostic: no account or resource IDs are committed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sf-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Next to D1 (ADR 0241), for the fetch handlers: the runner channel and the GitHub webhook. RPC
  // from sf-app runs where sf-app runs.
  "placement": { "region": "aws:us-west-1" },
  "observability": {
    "enabled": true
  },
  // Runner hosts reach the channel here (outbound HTTPS from the runner, ADR 0016). Nothing else on
  // this host is public: the operations API is RPC over a service binding (ADR 0051).
  // The GitHub App's webhook (V1 step 4) is a Workers route on sf-app's hostname: routes run in front
  // of a Custom Domain, so /webhooks/* reaches this Worker without sf-app forwarding it.
  "routes": [
    { "pattern": "sf-engine.zerobsai.com", "custom_domain": true },
    { "pattern": "software-factory.zerobsai.com/webhooks/*", "zone_name": "zerobsai.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // The factory's one database. Bound by name; created by scripts/deploy/provision.ts. Migrations
  // live in packages/db and are applied from here (the first Worker in deploy order that sets them).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "software-factory",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // One instance per work item; the instance id is the work item id (ADR 0006, 0053).
  // Work item attachments (ADR 0310): private, reached only through the attachment operations.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "sf-attachments" }],
  // One PlanningHub per work item (spec 20, ADR 0350): live Planning tabs and the planning
  // agent's held waits hear about changes here.
  "durable_objects": {
    "bindings": [
      { "name": "PLANNING_HUB", "class_name": "PlanningHub" },
      // One ClientHub per person (spec 40 M2b): their desktop apps' live connections.
      { "name": "CLIENT_HUB", "class_name": "ClientHub" },
      // One TerminalRelay per job (spec 35, ADR 0440): its web terminal's host and viewer sockets.
      { "name": "TERMINAL_RELAY", "class_name": "TerminalRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1-planning-hub", "new_sqlite_classes": ["PlanningHub"] },
    { "tag": "v2-client-hub", "new_sqlite_classes": ["ClientHub"] },
    { "tag": "v3-terminal-relay", "new_sqlite_classes": ["TerminalRelay"] }
  ],
  "workflows": [
    {
      "binding": "WORK_ITEM_WORKFLOW",
      "name": "sf-work-item",
      "class_name": "WorkItemWorkflow"
    }
  ],
  // Outbox retries, quiet-run sweeps and channel-store pruning, every minute.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://software-factory.zerobsai.com",
    "GH_APP_ID": "5705909",
    // Its pushes show up as `<slug>[bot]` in push webhooks (ADR 0052, branch confinement).
    "GH_APP_SLUG": "software-factory-zerobsai",
    // The global floor (ADR 0008): JSON, actor|"*" → risk|"*" → "allow"|"review"|"deny". It can only
    // tighten; anything malformed denies every call. Empty = no floor.
    "FACTORY_FLOOR": "",
    // The default-branch commit this engine was deployed from (ADR 0360): the deploy sets it with
    // `--var DEPLOYED_SHA:<sha>`. Empty: a dev engine (no updates).
    "DEPLOYED_SHA": "",
    // The last commit at or before DEPLOYED_SHA that changed runner code (ADR 0520): the deploy
    // computes it with git and sets `--var RUNNER_SHA:<sha>`, and runners are asked to run it, so a
    // deploy that changed no runner code moves no runner. Empty: runners get DEPLOYED_SHA.
    "RUNNER_SHA": "",
    // Accept presence proofs from desktop devices with a software key (ADR 0391): "1" only on a local
    // dev engine. Anything else refuses them, so a gate decision needs a Secure Enclave key.
    "DESKTOP_ALLOW_SOFTWARE_KEYS": "",
    // The oldest desktop door protocol the client door serves (ADR 0393). Older builds get 426
    // `update_required` and update themselves. Empty or 0 = serve every build. Raise it only when
    // older builds must stop; the app's own number is DOOR_PROTOCOL in apps/desktop. CI and the
    // deploy refuse a floor above what the newest published build speaks (scripts/deploy/desktop-floor.ts).
    "DESKTOP_MIN_PROTOCOL": "",
    // The phone app's signing certificates (ADR 0541): SHA-256, comma-separated, as `keytool -list
    // -v` prints them. A phone registers only if Android attests our package signed with one of
    // these. The release key's goes here once the owner makes it (spec 60, "What the owner must
    // do"); a dev engine may add the debug key's. Empty: every phone sign-in is refused.
    "MOBILE_SIGNING_CERTS": "",
    // "1" swaps the GitHub App for an in-D1 fake (tests and local dev only).
    "GITHUB_FAKE": ""
  }
  // Secrets (set by the deploy workflow with `wrangler secret bulk`, never committed):
  // RUNNER_CHANNEL_SECRET, GH_APP_PRIVATE_KEY and GH_APP_WEBHOOK_SECRET. They are typed in src/secrets.ts rather than with
  // `secrets.required`, which would make `wrangler deploy` fail until they exist. Without them the
  // runner channel answers 503 and GitHub calls are refused as `unavailable`.
}
