<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The runtimes' hardened-runtime exceptions (ADR 0390): Bun (JavaScriptCore) and Node (V8) JIT
     compile, so they need executable memory. Nothing else: no keychain access group (only the key
     helper may carry one, ADR 0391), no library-validation opt-out. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
