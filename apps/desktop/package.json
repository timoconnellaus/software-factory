{
  "name": "@software-factory/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The desktop app (ADR 0370, spec 30): the daily UI on macOS, built on Electrobun 2.x with Hutch. It supervises this Mac's sf-runner and calls operations through the client door with a desktop token.",
  "scripts": {
    "devkit": "electrobun prepare",
    "typecheck": "electrobun prepare && tsc --noEmit",
    "test": "vitest run",
    "build": "electrobun prepare && vite build",
    "bundle": "sh scripts/bundle.sh dev",
    "bundle:canary": "sh scripts/bundle.sh canary",
    "dev": "sh scripts/bundle.sh dev && sh scripts/run.sh"
  },
  "dependencies": {
    "@software-factory/ui": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@software-factory/config": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "bun-types": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electrobun": "2.0.6",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
