{
  "version": 1,
  "autonomyPolicy": "balanced",
  "overrides": { "agent": { "outbound": "allow" } },
  "spec": { "requiredFrom": "medium" },
  "timeouts": { "gateHours": 72, "questionHours": 48 },
  "wipLimit": 5,
  "retryLimit": 2,
  "checks": [
    { "name": "install", "run": "pnpm install --frozen-lockfile", "timeoutMinutes": 15 },
    { "name": "lint", "run": "pnpm lint", "timeoutMinutes": 10 },
    {
      "name": "test",
      "run": "TURBO_TELEMETRY_DISABLED=1 VITEST_MAX_WORKERS=2 pnpm turbo run test --concurrency=1 --continue --env-mode=loose",
      "timeoutMinutes": 60
    }
  ],
  "approvers": ["timoconnellaus"],
  "backupOwner": "timoconnellaus",
  "reviewPacket": { "sections": ["verdict", "changed", "criteria", "reviewer", "risk", "diff"] }
}
